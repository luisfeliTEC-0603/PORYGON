/** @brief Exporta configuracion y contadores crudos congelados, sin cocientes. */
task automatic export_metrics(input integer fd);
    $fdisplay(fd, "cpu_hz=%0d", perf_snapshot.configuration.cpu_hz);
    $fdisplay(fd, "memory_bytes=%0d", perf_snapshot.configuration.memory_bytes);
    $fdisplay(fd, "l1_bytes=%0d", perf_snapshot.configuration.l1_bytes);
    $fdisplay(fd, "l1_ways=%0d", perf_snapshot.configuration.l1_ways);
    $fdisplay(fd, "l2_bytes=%0d", perf_snapshot.configuration.l2_bytes);
    $fdisplay(fd, "l2_ways=%0d", perf_snapshot.configuration.l2_ways);
    $fdisplay(fd, "line_bytes=%0d", perf_snapshot.configuration.line_bytes);
    $fdisplay(fd, "write_buffer_depth=%0d", perf_snapshot.configuration.write_buffer_depth);
    $fdisplay(fd, "eviction_buffer_depth=%0d", perf_snapshot.configuration.eviction_buffer_depth);
    $fdisplay(fd, "l2_max_inflight=%0d", perf_snapshot.configuration.l2_max_inflight);
    $fdisplay(fd, "mem_clock_div=%0d", perf_snapshot.configuration.mem_clock_div);
    $fdisplay(fd, "mem_read_first_word_cycles=%0d", perf_snapshot.configuration.mem_read_first_word_cycles);
    $fdisplay(fd, "mem_write_first_word_cycles=%0d", perf_snapshot.configuration.mem_write_first_word_cycles);
    $fdisplay(fd, "mem_timeout_cycles=%0d", perf_snapshot.configuration.mem_timeout_cycles);
    $fdisplay(fd, "reference_without_cache=%0d", perf_snapshot.configuration.reference_without_cache);
    $fdisplay(fd, "cpu_cycles=%0d", perf_snapshot.cpu.cycles);
    $fdisplay(fd, "cpu_bundles=%0d", perf_snapshot.cpu.bundles);
    $fdisplay(fd, "cpu_instructions=%0d", perf_snapshot.cpu.instructions);
    $fdisplay(fd, "cpu_nop_slots=%0d", perf_snapshot.cpu.nop_slots);
    $fdisplay(fd, "cpu_literal_slots=%0d", perf_snapshot.cpu.literal_slots);
    $fdisplay(fd, "cpu_stall_cycles=%0d", perf_snapshot.cpu.stall_cycles);
    $fdisplay(fd, "cpu_wait_accept=%0d", perf_snapshot.cpu.wait_accept);
    $fdisplay(fd, "cpu_wait_miss=%0d", perf_snapshot.cpu.wait_miss);
    $fdisplay(fd, "cpu_wait_rsp=%0d", perf_snapshot.cpu.wait_rsp);
    $fdisplay(fd, "cpu_branches=%0d", perf_snapshot.cpu.branches);
    $fdisplay(fd, "cpu_branches_taken=%0d", perf_snapshot.cpu.branches_taken);
    $fdisplay(fd, "cpu_branch_delay_cycles=%0d", perf_snapshot.cpu.branch_delay_cycles);
    $fdisplay(fd, "cpu_stage_if_occupied=%0d", perf_snapshot.cpu.stage_if.occupied);
    $fdisplay(fd, "cpu_stage_if_transfers=%0d", perf_snapshot.cpu.stage_if.transfers);
    $fdisplay(fd, "cpu_stage_if_mem_stalls=%0d", perf_snapshot.cpu.stage_if.mem_stalls);
    $fdisplay(fd, "cpu_stage_id_occupied=%0d", perf_snapshot.cpu.stage_id.occupied);
    $fdisplay(fd, "cpu_stage_id_transfers=%0d", perf_snapshot.cpu.stage_id.transfers);
    $fdisplay(fd, "cpu_stage_id_mem_stalls=%0d", perf_snapshot.cpu.stage_id.mem_stalls);
    $fdisplay(fd, "cpu_stage_ex_occupied=%0d", perf_snapshot.cpu.stage_ex.occupied);
    $fdisplay(fd, "cpu_stage_ex_transfers=%0d", perf_snapshot.cpu.stage_ex.transfers);
    $fdisplay(fd, "cpu_stage_ex_mem_stalls=%0d", perf_snapshot.cpu.stage_ex.mem_stalls);
    $fdisplay(fd, "cpu_stage_wb_occupied=%0d", perf_snapshot.cpu.stage_wb.occupied);
    $fdisplay(fd, "cpu_stage_wb_transfers=%0d", perf_snapshot.cpu.stage_wb.transfers);
    $fdisplay(fd, "cpu_stage_wb_mem_stalls=%0d", perf_snapshot.cpu.stage_wb.mem_stalls);
    $fdisplay(fd, "dmem_completed=%0d", perf_snapshot.dmem.completed);
    $fdisplay(fd, "dmem_failed=%0d", perf_snapshot.dmem.failed);
    $fdisplay(fd, "dmem_reads_completed=%0d", perf_snapshot.dmem.reads_completed);
    $fdisplay(fd, "dmem_writes_completed=%0d", perf_snapshot.dmem.writes_completed);
    $fdisplay(fd, "dmem_latency_sum=%0d", perf_snapshot.dmem.latency_sum);
    $fdisplay(fd, "dmem_read_latency_sum=%0d", perf_snapshot.dmem.read_latency_sum);
    $fdisplay(fd, "dmem_write_latency_sum=%0d", perf_snapshot.dmem.write_latency_sum);
    $fdisplay(fd, "dmem_miss_stalls_wb=%0d", perf_snapshot.dmem.miss_stalls_wb);
    $fdisplay(fd, "dmem_miss_stalls_l2=%0d", perf_snapshot.dmem.miss_stalls_l2);
    $fdisplay(fd, "dmem_miss_stalls_mem=%0d", perf_snapshot.dmem.miss_stalls_mem);
    $fdisplay(fd, "l1_reads=%0d", perf_snapshot.l1.reads);
    $fdisplay(fd, "l1_writes=%0d", perf_snapshot.l1.writes);
    $fdisplay(fd, "l1_read_hits=%0d", perf_snapshot.l1.read_hits);
    $fdisplay(fd, "l1_read_misses=%0d", perf_snapshot.l1.read_misses);
    $fdisplay(fd, "l1_write_hits=%0d", perf_snapshot.l1.write_hits);
    $fdisplay(fd, "l1_write_misses=%0d", perf_snapshot.l1.write_misses);
    $fdisplay(fd, "l1_invalid_reads=%0d", perf_snapshot.l1.invalid_reads);
    $fdisplay(fd, "l1_invalid_writes=%0d", perf_snapshot.l1.invalid_writes);
    $fdisplay(fd, "l1_evictions_clean=%0d", perf_snapshot.l1.evictions_clean);
    $fdisplay(fd, "l1_evictions_dirty=%0d", perf_snapshot.l1.evictions_dirty);
    $fdisplay(fd, "l2_demands=%0d", perf_snapshot.l2.demands);
    $fdisplay(fd, "l2_hits=%0d", perf_snapshot.l2.hits);
    $fdisplay(fd, "l2_misses=%0d", perf_snapshot.l2.misses);
    $fdisplay(fd, "l2_promotions=%0d", perf_snapshot.l2.promotions);
    $fdisplay(fd, "l2_evictions_clean=%0d", perf_snapshot.l2.evictions_clean);
    $fdisplay(fd, "l2_evictions_dirty=%0d", perf_snapshot.l2.evictions_dirty);
    $fdisplay(fd, "l2_inflight_sum=%0d", perf_snapshot.l2.inflight_sum);
    $fdisplay(fd, "l2_inflight_max=%0d", perf_snapshot.l2.inflight_max);
    $fdisplay(fd, "l2_full_cycles=%0d", perf_snapshot.l2.full_cycles);
    $fdisplay(fd, "l2_get_wait_cycles=%0d", perf_snapshot.l2.get_wait_cycles);
    $fdisplay(fd, "wb_enqueued=%0d", perf_snapshot.wb.enqueued);
    $fdisplay(fd, "wb_forwarded=%0d", perf_snapshot.wb.forwarded);
    $fdisplay(fd, "wb_sent=%0d", perf_snapshot.wb.sent);
    $fdisplay(fd, "wb_installed=%0d", perf_snapshot.wb.installed);
    $fdisplay(fd, "wb_occupancy_sum=%0d", perf_snapshot.wb.occupancy_sum);
    $fdisplay(fd, "wb_occupancy_max=%0d", perf_snapshot.wb.occupancy_max);
    $fdisplay(fd, "wb_full_cycles=%0d", perf_snapshot.wb.full_cycles);
    $fdisplay(fd, "wb_push_wait_cycles=%0d", perf_snapshot.wb.push_wait_cycles);
    $fdisplay(fd, "wb_install_wait_cycles=%0d", perf_snapshot.wb.install_wait_cycles);
    $fdisplay(fd, "wb_raw_wait_cycles=%0d", perf_snapshot.wb.raw_wait_cycles);
    $fdisplay(fd, "eb_enqueued=%0d", perf_snapshot.eb.enqueued);
    $fdisplay(fd, "eb_sent=%0d", perf_snapshot.eb.sent);
    $fdisplay(fd, "eb_written=%0d", perf_snapshot.eb.written);
    $fdisplay(fd, "eb_occupancy_sum=%0d", perf_snapshot.eb.occupancy_sum);
    $fdisplay(fd, "eb_occupancy_max=%0d", perf_snapshot.eb.occupancy_max);
    $fdisplay(fd, "eb_full_cycles=%0d", perf_snapshot.eb.full_cycles);
    $fdisplay(fd, "eb_push_wait_cycles=%0d", perf_snapshot.eb.push_wait_cycles);
    $fdisplay(fd, "eb_raw_wait_cycles=%0d", perf_snapshot.eb.raw_wait_cycles);
    $fdisplay(fd, "mem_reads=%0d", perf_snapshot.mem.reads);
    $fdisplay(fd, "mem_writes=%0d", perf_snapshot.mem.writes);
    $fdisplay(fd, "mem_reads_complete=%0d", perf_snapshot.mem.reads_complete);
    $fdisplay(fd, "mem_writes_complete=%0d", perf_snapshot.mem.writes_complete);
    $fdisplay(fd, "mem_read_words=%0d", perf_snapshot.mem.read_words);
    $fdisplay(fd, "mem_write_words=%0d", perf_snapshot.mem.write_words);
    $fdisplay(fd, "mem_read_cycles=%0d", perf_snapshot.mem.read_cycles);
    $fdisplay(fd, "mem_write_cycles=%0d", perf_snapshot.mem.write_cycles);
    $fdisplay(fd, "mem_read_wait_cycles=%0d", perf_snapshot.mem.read_wait_cycles);
    $fdisplay(fd, "mem_write_wait_cycles=%0d", perf_snapshot.mem.write_wait_cycles);
    $fdisplay(fd, "mem_read_rsp_wait_cycles=%0d", perf_snapshot.mem.read_rsp_wait_cycles);
    $fdisplay(fd, "mem_write_rsp_wait_cycles=%0d", perf_snapshot.mem.write_rsp_wait_cycles);
    $fdisplay(fd, "mem_timeouts=%0d", perf_snapshot.mem.timeouts);
    $fdisplay(fd, "mem_errors=%0d", perf_snapshot.mem.errors);
    $fdisplay(fd, "pending_wb_entries=%0d", perf_snapshot.pending.wb_entries);
    $fdisplay(fd, "pending_eb_entries=%0d", perf_snapshot.pending.eb_entries);
    $fdisplay(fd, "pending_l2_inflight=%0d", perf_snapshot.pending.l2_inflight);
    $fdisplay(fd, "pending_mem_reads=%0d", perf_snapshot.pending.mem_reads);
    $fdisplay(fd, "pending_mem_writes=%0d", perf_snapshot.pending.mem_writes);
    $fdisplay(fd, "pending_mem_read_responses=%0d", perf_snapshot.pending.mem_read_responses);
    $fdisplay(fd, "pending_mem_write_responses=%0d", perf_snapshot.pending.mem_write_responses);
    $fdisplay(fd, "failed=%0d", perf_snapshot.failed);
    $fdisplay(fd, "overflow=%0d", perf_snapshot.overflow);
    $fdisplay(fd, "error_events=%0d", perf_snapshot.error_events);
endtask
